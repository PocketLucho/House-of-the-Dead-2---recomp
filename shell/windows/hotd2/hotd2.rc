// THE HOUSE OF THE DEAD 2 - RECOMP: executable icon and version info
#include "../resource.h"
#include "../../../core/version.h"

IDI_ICON1               ICON                    "hotd2.ico"

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904E4"
    BEGIN
      VALUE "CompanyName", "Pocket_lucho"
      VALUE "FileDescription", "THE HOUSE OF THE DEAD 2 - RECOMP"
      VALUE "FileVersion", __DATE__
      VALUE "InternalName", "HouseOfTheDead2-Recompiled"
      VALUE "LegalCopyright", "Made by Pocket_lucho with Claude. Based on Flycast (GNU GPL)."
      VALUE "OriginalFilename", "HouseOfTheDead2-Recompiled.exe"
      VALUE "ProductName", "THE HOUSE OF THE DEAD 2 - RECOMP"
      VALUE "ProductVersion", __DATE__
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1252
  END
END
